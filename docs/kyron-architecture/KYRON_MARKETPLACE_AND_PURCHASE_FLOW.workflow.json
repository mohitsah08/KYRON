    {
      "id": "e7",
      "from": "w_funds",
      "to": "w_grant",
      "label": "Sufficient",
      "variant": "emphasis"
    },
    {
      "id": "e8",
      "from": "w_grant",
      "to": "w_dashboard",
      "label": "Unlock Code",
      "variant": "emphasis"
    },
    {
      "id": "e9",
      "from": "w_dashboard",
      "to": "w_mcp_run",
      "label": "Execute Agent",
      "variant": "default"
    }
