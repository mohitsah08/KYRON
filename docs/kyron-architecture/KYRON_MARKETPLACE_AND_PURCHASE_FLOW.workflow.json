  "cards": [
    {
      "dot": "cyan",
      "title": "Discovery to Acquisition",
      "items": [
        "Buyers browse 32 categories in catalog and filter by tags, rating, or search query",
        "Skill detail page displays deal price in credits and verified 8-point AST security score",
        "Wallet policy ensures user has sufficient credits before granting access"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fulfillment & Execution",
      "items": [
        "Atomic database transaction deducts balance and creates user_purchases record",
        "Skill immediately appears in user library on /dashboard with license key and package tree",
        "Buyer connects MCP config snippet to Claude Desktop, Cursor, or Antigravity"
      ]
    }
  ]
