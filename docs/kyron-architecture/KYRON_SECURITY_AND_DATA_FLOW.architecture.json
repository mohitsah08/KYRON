  "cards": [
    {
      "dot": "rose",
      "title": "8-Point Threat Scanner Specification",
      "items": [
        "Rule 1: Enforces valid YAML frontmatter containing required name, description, and version",
        "Rule 2: Detects adversarial prompt injection patterns, role-escapes, and jailbreak markers",
        "Rules 3-5: Blocks destructive filesystem commands (rm -rf), credential exfiltration, and reverse shells",
        "Rules 6-8: Audits suspicious telemetry, obfuscated eval execution, and dry-run syntax parsing"
      ]
    },
    {
      "dot": "emerald",
      "title": "Zero-Trust Publishing & Isolation",
      "items": [
        "Every single submission undergoes all 8 rules prior to touching catalog tables",
        "Any failed check halts execution with HTTP 400 and returns precise diagnostic findings",
        "Audit findings are permanently indexed in security_audit_logs for public review on skill cards",
        "Package files are quarantined in skill_packages and released only upon valid entitlement grant"
      ]
    }
